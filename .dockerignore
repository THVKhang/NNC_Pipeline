# What git ignores stays out of the image too (see .gitignore): licensed standards, agent caches and logs,
# simulation outputs, local tool settings.
.git
.github
.claude/settings.local.json
**/__pycache__
**/*.pyc
build
*.egg-info
specs
designs/axi_std
corpus/.cache
designs/*/work/logs
designs/*/work/manual
designs/*/work/baseline/*/rtl
designs/*/work/bench/*/rtl
designs/*/work/bench/*/runs
designs/*/work/bench/*/sim.log
designs/*/review_kit
designs/*/review_kit.zip
designs/*/fix_candidate/**/runs
designs/*/fix_candidate/**/sim.log
designs/*/bug_demo/sim.log
designs/*/sim/runlogs
**/sim_build
**/obj_dir
**/results.xml
**/coverage.dat
**/coverage.info
**/coverage_annotated
designs/*/sim/sim.log
designs/*/sim/*/sim.log
