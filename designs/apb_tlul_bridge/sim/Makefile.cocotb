# Generated by NNC Pipeline: cocotb part of the reproduction kit (called by Makefile).
TOP_DIR := $(abspath ..)
SIM ?= verilator
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(TOP_DIR)/rtl/m_apb_if.sv $(TOP_DIR)/rtl/m_tlul_if.sv $(TOP_DIR)/rtl/m_apb_tlul_bridge.sv $(TOP_DIR)/verif/sva/nnc_chk_apb.sv $(TOP_DIR)/verif/sva/nnc_chk_cross.sv $(TOP_DIR)/verif/sva/nnc_chk_reset.sv $(TOP_DIR)/verif/sva/nnc_chk_tlul.sv $(TOP_DIR)/verif/sva/nnc_cov.sv $(CURDIR)/nnc_tb_top.sv
COCOTB_TOPLEVEL = nnc_tb_top
COCOTB_TEST_MODULES ?= test_apb_tlul_bridge,test_apb_tlul_bridge_cov1
EXTRA_ARGS += --assert --timing -Wno-fatal -Wno-WIDTH -Wno-UNOPTFLAT -GPARA_ADDR_W=32 -GPARA_SRC_W=8 -GPARA_SRC_ID=0 -GPARA_A_USER_W=1 -GPARA_D_SINK_W=1 -GPARA_D_USER_W=1 --coverage-line --coverage-toggle --coverage-expr
SEED ?= 1
export NNC_SEED = $(SEED)
export COCOTB_RANDOM_SEED = $(SEED)
export PYTHONPATH := $(CURDIR):$(TOP_DIR)/verif/tests:$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim
