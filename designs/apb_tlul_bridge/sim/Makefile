# Generated by NNC Pipeline (nnc sim) from work/contract.json. Do not edit: the next run rewrites it.
# Reproduces the verification of this design WITHOUT NNC: every EDA command is in a recipe below or in
# cocotb's Makefile.sim (see it with `make -n regression`). Tools: Verilator 5 (--timing), cocotb 2,
# GNU make, Python 3. Run from this folder on Linux or inside WSL.
TOP_DIR   := $(abspath ..)
RTL       := $(TOP_DIR)/rtl/m_apb_if.sv $(TOP_DIR)/rtl/m_tlul_if.sv $(TOP_DIR)/rtl/m_apb_tlul_bridge.sv
SVA       := $(TOP_DIR)/verif/sva/nnc_chk_apb.sv $(TOP_DIR)/verif/sva/nnc_chk_cross.sv $(TOP_DIR)/verif/sva/nnc_chk_reset.sv $(TOP_DIR)/verif/sva/nnc_chk_tlul.sv $(TOP_DIR)/verif/sva/nnc_cov.sv
TESTS     := test_apb_tlul_bridge,test_apb_tlul_bridge_cov1
TOP       := m_apb_tlul_bridge
PARAMS    := -GPARA_ADDR_W=32 -GPARA_SRC_W=8 -GPARA_SRC_ID=0 -GPARA_A_USER_W=1 -GPARA_D_SINK_W=1 -GPARA_D_USER_W=1
DEFINES   := 
SEED      ?= 1
TC        ?=
COVERAGE  := --coverage-line --coverage-toggle --coverage-expr
VERILATOR ?= verilator

.PHONY: help tool-check lint sva-compile regression test coverage-report clean

help:            ## list the targets and their inputs/outputs
	@echo "Targets (inputs: ../rtl, ../verif/sva, ../verif/tests; outputs in this folder):"
	@echo "  tool-check       versions of verilator, cocotb, python3"
	@echo "  lint             verilator --lint-only of the DUT RTL (top $(TOP))"
	@echo "  sva-compile      checkers + contract shell (syntax/elaboration only, never a DUT result)"
	@echo "  regression       every test module on the DUT with the checkers -> results.xml, sim log, coverage.dat"
	@echo "  test TC=<regex>  only the cocotb tests whose name matches, e.g. TC=test_chk_003"
	@echo "  coverage-report  coverage.dat -> coverage.info (lcov) and annotated sources in coverage_annotated/"
	@echo "  clean"
	@echo "Variables: SEED=$(SEED) (random seed), PARAMS=$(PARAMS), DEFINES=$(DEFINES)"

tool-check:
	$(VERILATOR) --version
	cocotb-config --version
	python3 --version

lint:
	$(VERILATOR) --lint-only -Wno-fatal --top-module $(TOP) $(PARAMS) $(DEFINES) $(RTL)

sva-compile:
	$(VERILATOR) --lint-only --timing -Wno-fatal --top-module nnc_tb_top $(PARAMS) contract_shell.sv $(SVA) nnc_tb_top.sv

regression:
	$(MAKE) -f Makefile.cocotb SEED=$(SEED) COCOTB_TEST_MODULES=$(TESTS)

test:
	$(MAKE) -f Makefile.cocotb SEED=$(SEED) COCOTB_TEST_MODULES=$(TESTS) COCOTB_TEST_FILTER='$(TC)'

coverage-report:
	verilator_coverage --write-info coverage.info coverage.dat
	verilator_coverage --annotate coverage_annotated coverage.dat

clean:
	rm -rf sim_build results.xml coverage.dat coverage.info coverage_annotated __pycache__
