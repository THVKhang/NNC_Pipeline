SIM ?= verilator
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(TOP_DIR)/rtl/prim_assert_dummy_macros.svh $(TOP_DIR)/rtl/prim_assert_sec_cm.svh $(TOP_DIR)/rtl/prim_assert.sv $(TOP_DIR)/rtl/prim_flop_macros.sv $(TOP_DIR)/rtl/prim_util_pkg.sv $(TOP_DIR)/rtl/prim_mubi_pkg.sv $(TOP_DIR)/rtl/prim_secded_pkg.sv $(TOP_DIR)/rtl/top_pkg.sv $(TOP_DIR)/rtl/tlul_pkg.sv $(TOP_DIR)/rtl/prim_alert_pkg.sv $(TOP_DIR)/rtl/top_racl_pkg.sv $(TOP_DIR)/rtl/prim_subreg_pkg.sv $(TOP_DIR)/rtl/gpio_pkg.sv $(TOP_DIR)/rtl/gpio_reg_pkg.sv $(TOP_DIR)/rtl/prim_alert_receiver.sv $(TOP_DIR)/rtl/prim_alert_sender.sv $(TOP_DIR)/rtl/prim_buf.sv $(TOP_DIR)/rtl/prim_diff_decode.sv $(TOP_DIR)/rtl/prim_filter_ctr.sv $(TOP_DIR)/rtl/prim_flop.sv $(TOP_DIR)/rtl/prim_flop_2sync.sv $(TOP_DIR)/rtl/prim_intr_hw.sv $(TOP_DIR)/rtl/prim_onehot_check.sv $(TOP_DIR)/rtl/prim_onehot_enc.sv $(TOP_DIR)/rtl/prim_reg_we_check.sv $(TOP_DIR)/rtl/prim_sec_anchor_buf.sv $(TOP_DIR)/rtl/prim_sec_anchor_flop.sv $(TOP_DIR)/rtl/prim_secded_inv_39_32_dec.sv $(TOP_DIR)/rtl/prim_secded_inv_39_32_enc.sv $(TOP_DIR)/rtl/prim_secded_inv_64_57_dec.sv $(TOP_DIR)/rtl/prim_secded_inv_64_57_enc.sv $(TOP_DIR)/rtl/prim_subreg.sv $(TOP_DIR)/rtl/prim_subreg_arb.sv $(TOP_DIR)/rtl/prim_subreg_ext.sv $(TOP_DIR)/rtl/prim_xnor2.sv $(TOP_DIR)/rtl/tlul_adapter_reg.sv $(TOP_DIR)/rtl/tlul_cmd_intg_chk.sv $(TOP_DIR)/rtl/tlul_cmd_intg_gen.sv $(TOP_DIR)/rtl/tlul_data_integ_dec.sv $(TOP_DIR)/rtl/tlul_data_integ_enc.sv $(TOP_DIR)/rtl/tlul_err.sv $(TOP_DIR)/rtl/tlul_rsp_intg_chk.sv $(TOP_DIR)/rtl/tlul_rsp_intg_gen.sv $(TOP_DIR)/rtl/gpio_reg_top.sv $(TOP_DIR)/rtl/gpio.sv $(TOP_DIR)/rtl/ot_gpio_nnc.sv $(TOP_DIR)/verif/sva/nnc_chk_alert.sv $(TOP_DIR)/verif/sva/nnc_chk_gpio.sv $(TOP_DIR)/verif/sva/nnc_chk_integ.sv $(TOP_DIR)/verif/sva/nnc_chk_intr.sv $(TOP_DIR)/verif/sva/nnc_chk_reset.sv $(TOP_DIR)/verif/sva/nnc_chk_strap.sv $(TOP_DIR)/verif/sva/nnc_chk_timing.sv $(TOP_DIR)/verif/sva/nnc_chk_tlhost.sv $(TOP_DIR)/verif/sva/nnc_chk_tlul.sv $(TOP_DIR)/verif/sva/nnc_cov.sv $(KIT_DIR)/nnc_tb_top.sv
COCOTB_TOPLEVEL = nnc_tb_top
COCOTB_TEST_MODULES ?= test_ot_gpio,test_ot_gpio_cov1
EXTRA_ARGS += --assert --timing -Wno-fatal -Wno-WIDTH -Wno-UNOPTFLAT +incdir+$(TOP_DIR)/rtl -GGpioAsyncOn=0 -GGpioAsHwStrapsEn=0 --coverage-line --coverage-toggle --coverage-expr
SEED ?= 1
export NNC_SEED = $(SEED)
export COCOTB_RANDOM_SEED = $(SEED)
export NNC_INTERFACE := $(CURDIR)/nnc_interface.json
export PYTHONPATH := $(KIT_DIR):$(TOP_DIR)/verif/tests:$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim
