# Generated by NNC Pipeline: cocotb part of the reproduction kit (called by Makefile).
TOP_DIR := $(abspath ..)
SIM ?= verilator
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(TOP_DIR)/rtl/m_spi_master.sv $(TOP_DIR)/verif/sva/nnc_chk_cmd.sv $(TOP_DIR)/verif/sva/nnc_chk_cs.sv $(TOP_DIR)/verif/sva/nnc_chk_flow.sv $(TOP_DIR)/verif/sva/nnc_chk_mosi.sv $(TOP_DIR)/verif/sva/nnc_chk_reset.sv $(TOP_DIR)/verif/sva/nnc_chk_rsp.sv $(TOP_DIR)/verif/sva/nnc_chk_sclk.sv $(TOP_DIR)/verif/sva/nnc_cov.sv $(CURDIR)/nnc_tb_top.sv
COCOTB_TOPLEVEL = nnc_tb_top
COCOTB_TEST_MODULES ?= test_spi_master
EXTRA_ARGS += --assert --timing -Wno-fatal -Wno-WIDTH -Wno-UNOPTFLAT +incdir+$(TOP_DIR)/rtl -GPARA_SPI_CLK_DIV=4 --coverage-line --coverage-toggle --coverage-expr
SEED ?= 1
export NNC_SEED = $(SEED)
export COCOTB_RANDOM_SEED = $(SEED)
export PYTHONPATH := $(CURDIR):$(TOP_DIR)/verif/tests:$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim
