{"rules": [{"sentences": ["12:s1"], "strength": "MUST", "actor": "slave", "signals": ["ARLEN", "RRESP", "RDATA", "RLAST"], "condition": "Unsupported read is detected (ERR-001)", "statement": "Respond with ARLEN+1 SLVERR read beats carrying zero data and RLAST on the final beat, without issuing any APB access.", "check": "both"}, {"sentences": ["12:s1"], "strength": "MUST", "actor": "slave", "signals": ["PSEL", "PENABLE"], "condition": "Unsupported read is detected (ERR-001)", "statement": "Do not generate any APB transfer for an unsupported read.", "check": "assertion"}, {"sentences": ["12:s2"], "strength": "MUST", "actor": "slave", "signals": ["WVALID", "WREADY", "WLAST", "BRESP", "BVALID"], "condition": "Unsupported write is detected (ERR-002)", "statement": "Drain the expected count of W beats, then complete the write with a B response of SLVERR, without any APB access.", "check": "both"}, {"sentences": ["12:s2"], "strength": "MUST", "actor": "slave", "signals": ["PSEL", "PENABLE"], "condition": "Unsupported write is detected (ERR-002)", "statement": "Do not generate any APB transfer for an unsupported write.", "check": "assertion"}, {"sentences": ["12:s3"], "strength": "MUST", "actor": "slave", "signals": ["PSLVERR", "RRESP", "RDATA"], "condition": "APB read returns PSLVERR (ERR-003)", "statement": "Return RRESP=SLVERR with RDATA=0 for the beat, and continue processing the remaining beats.", "check": "both"}, {"sentences": ["12:s4"], "strength": "MUST", "actor": "slave", "signals": ["PSLVERR", "BRESP"], "condition": "APB write returns PSLVERR (ERR-004)", "statement": "Accumulate the error, continue the remaining write beats, and return final BRESP=SLVERR.", "check": "both"}, {"sentences": ["12:s5"], "strength": "MUST", "actor": "slave", "signals": ["PREADY", "PSEL", "PENABLE"], "condition": "PREADY remains low (ERR-005)", "statement": "Hold the APB access indefinitely with no timeout until the completer responds or system reset occurs.", "check": "both"}, {"sentences": ["12:s6"], "strength": "MUST", "actor": "system", "signals": ["PREADY", "PSLVERR", "RRESP", "BRESP"], "condition": "Address is unmapped (ERR-006)", "statement": "Default Completer drives PREADY=1 and PSLVERR=1, and the bridge reports an AXI SLVERR response.", "check": "scenario"}, {"sentences": ["12:s8"], "strength": "MUST_NOT", "actor": "slave", "signals": ["PSLVERR", "RRESP", "BRESP"], "condition": "An APB failure occurs", "statement": "Never report an APB failure as AXI OKAY.", "check": "assertion"}, {"sentences": ["12:s1", "12:s2", "12:s3", "12:s4", "12:s6"], "strength": "MUST", "actor": "slave", "signals": [], "condition": "Reset occurs during error handling", "statement": "Reset cancels the in-progress error handling for ERR-001, ERR-002, ERR-003, ERR-004 and ERR-006.", "check": "scenario"}, {"sentences": ["12:s5"], "strength": "MUST", "actor": "slave", "signals": ["PSEL"], "condition": "Reset occurs while PREADY is low", "statement": "Reset deselects the APB completer.", "check": "both"}], "skipped": [{"sentence": "12:s7", "reason": "descriptive"}, {"sentence": "12:s9", "reason": "duplicate"}]}
