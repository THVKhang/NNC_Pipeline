# Generated by NNC Pipeline: cocotb part of configuration xrand (called by Makefile).
TOP_DIR := $(abspath ../../..)
KIT_DIR := $(abspath ../..)
SIM ?= verilator
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(TOP_DIR)/rtl/m_axi2apb_apb_ctrl.sv $(TOP_DIR)/rtl/m_axi2apb_rd_seq.sv $(TOP_DIR)/rtl/m_axi2apb_wr_seq.sv $(TOP_DIR)/rtl/m_axi2apb_bridge.sv $(TOP_DIR)/verif/sva/nnc_chk_apb.sv $(TOP_DIR)/verif/sva/nnc_chk_axi_b.sv $(TOP_DIR)/verif/sva/nnc_chk_axi_r.sv $(TOP_DIR)/verif/sva/nnc_chk_axi_w.sv $(TOP_DIR)/verif/sva/nnc_chk_cross.sv $(TOP_DIR)/verif/sva/nnc_chk_reset.sv $(TOP_DIR)/verif/sva/nnc_cov.sv $(KIT_DIR)/nnc_tb_top.sv
COCOTB_TOPLEVEL = nnc_tb_top
COCOTB_TEST_MODULES ?= test_axi2apb_bridge,test_axi2apb_bridge_cov1
EXTRA_ARGS += --assert --timing -Wno-fatal -Wno-WIDTH -Wno-UNOPTFLAT +incdir+$(TOP_DIR)/rtl -GPARA_AXI_ID_W=4 --coverage-line --coverage-toggle --coverage-expr
EXTRA_ARGS += --x-assign unique --x-initial unique +define+NNC_X_INIT
PLUSARGS += +verilator+rand+reset+2 +verilator+seed+$(shell expr $(SEED) + 1) +NNC_X_INIT
SEED ?= 1
export NNC_SEED = $(SEED)
export COCOTB_RANDOM_SEED = $(SEED)
export NNC_INTERFACE := $(CURDIR)/nnc_interface.json
export PYTHONPATH := $(KIT_DIR):$(TOP_DIR)/verif/tests:$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim
