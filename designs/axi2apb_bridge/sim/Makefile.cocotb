# Generated by NNC Pipeline: cocotb part of the reproduction kit (called by Makefile).
TOP_DIR := $(abspath ..)
SIM ?= verilator
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(TOP_DIR)/rtl/m_axi2apb_apb_ctrl.sv $(TOP_DIR)/rtl/m_axi2apb_rd_seq.sv $(TOP_DIR)/rtl/m_axi2apb_wr_seq.sv $(TOP_DIR)/rtl/m_axi2apb_bridge.sv $(TOP_DIR)/verif/sva/nnc_chk_apb.sv $(TOP_DIR)/verif/sva/nnc_chk_axi_b.sv $(TOP_DIR)/verif/sva/nnc_chk_axi_r.sv $(TOP_DIR)/verif/sva/nnc_chk_axi_w.sv $(TOP_DIR)/verif/sva/nnc_chk_cross.sv $(TOP_DIR)/verif/sva/nnc_chk_reset.sv $(TOP_DIR)/verif/sva/nnc_cov.sv $(CURDIR)/nnc_tb_top.sv
COCOTB_TOPLEVEL = nnc_tb_top
COCOTB_TEST_MODULES ?= test_axi2apb_bridge
EXTRA_ARGS += --assert --timing -Wno-fatal -Wno-WIDTH -Wno-UNOPTFLAT -GPARA_AXI_ID_W=4 --coverage-line --coverage-toggle --coverage-expr
SEED ?= 1
export NNC_SEED = $(SEED)
export COCOTB_RANDOM_SEED = $(SEED)
export PYTHONPATH := $(CURDIR):$(TOP_DIR)/verif/tests:$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim
