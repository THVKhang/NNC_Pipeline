# Generated by NNC Pipeline: cocotb part of configuration full_a7 (called by Makefile).
TOP_DIR := $(abspath ../../..)
KIT_DIR := $(abspath ../..)
SIM ?= verilator
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(TOP_DIR)/rtl/m_axil_regfile_dec.sv $(TOP_DIR)/rtl/m_axil_regfile.sv $(TOP_DIR)/verif/sva/nnc_chk_axi_rd.sv $(TOP_DIR)/verif/sva/nnc_chk_axi_wr.sv $(TOP_DIR)/verif/sva/nnc_chk_regs.sv $(TOP_DIR)/verif/sva/nnc_chk_reset.sv $(TOP_DIR)/verif/sva/nnc_chk_timing.sv $(TOP_DIR)/verif/sva/nnc_cov.sv $(KIT_DIR)/nnc_tb_top.sv
COCOTB_TOPLEVEL = nnc_tb_top
COCOTB_TEST_MODULES ?= test_axil_regfile
EXTRA_ARGS += --assert --timing -Wno-fatal -Wno-WIDTH -Wno-UNOPTFLAT -GPARA_NUM_REGS=16 -GPARA_ADDR_W=7 --coverage-line --coverage-toggle --coverage-expr
SEED ?= 1
export NNC_SEED = $(SEED)
export COCOTB_RANDOM_SEED = $(SEED)
export NNC_INTERFACE := $(CURDIR)/nnc_interface.json
export PYTHONPATH := $(KIT_DIR):$(TOP_DIR)/verif/tests:$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim
