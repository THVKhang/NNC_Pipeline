# Generated by NNC Pipeline: cocotb part of the reproduction kit (called by Makefile).
TOP_DIR := $(abspath ..)
SIM ?= verilator
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(TOP_DIR)/rtl/VLSIT_CELL_SYNC_DFF_RN.sv $(TOP_DIR)/rtl/VLSIT_CELL_SYNC_DFF_SN.sv $(TOP_DIR)/rtl/VLSIT_CELL_SYNC_2FF_RN.sv $(TOP_DIR)/rtl/VLSIT_CELL_SYNC_2FF_SN.sv $(TOP_DIR)/rtl/VLSIT_CELL_SYNC_3FF_RN.sv $(TOP_DIR)/rtl/VLSIT_CELL_SYNC_3FF_SN.sv $(TOP_DIR)/rtl/VLSIT_CELL_SYNC_4FF_RN.sv $(TOP_DIR)/rtl/VLSIT_CELL_SYNC_4FF_SN.sv $(TOP_DIR)/rtl/VLSIT_CELL_SRAM_1W1R.sv $(TOP_DIR)/rtl/m_vlsit_afifo_ram_macro.sv $(TOP_DIR)/rtl/m_vlsit_afifo_mem.sv $(TOP_DIR)/rtl/m_vlsit_afifo_cell_sync.sv $(TOP_DIR)/rtl/m_vlsit_afifo_sync.sv $(TOP_DIR)/rtl/m_vlsit_afifo_rd.sv $(TOP_DIR)/rtl/m_vlsit_afifo_wr.sv $(TOP_DIR)/rtl/m_vlsit_afifo_top.sv $(TOP_DIR)/verif/sva/nnc_chk_rd.sv $(TOP_DIR)/verif/sva/nnc_chk_sb.sv $(TOP_DIR)/verif/sva/nnc_chk_wr.sv $(TOP_DIR)/verif/sva/nnc_cov.sv $(CURDIR)/nnc_tb_top.sv
COCOTB_TOPLEVEL = nnc_tb_top
COCOTB_TEST_MODULES ?= test_async_gray_fifo
EXTRA_ARGS += --assert --timing -Wno-fatal -Wno-WIDTH -Wno-UNOPTFLAT -GPARA_AFIFO_DEPTH=8 -GPARA_AFIFO_DATA_W=32 -GPARA_AFIFO_CELL_TYPE=2 -GPARA_AFIFO_MEM_USE_MACRO=0 --coverage-line --coverage-toggle --coverage-expr
PLUSARGS += +AFIFO_MSYNC_SEED=$(SEED) +AFIFO_MSYNC_EN=1
SEED ?= 1
export NNC_SEED = $(SEED)
export COCOTB_RANDOM_SEED = $(SEED)
export PYTHONPATH := $(CURDIR):$(TOP_DIR)/verif/tests:$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim
