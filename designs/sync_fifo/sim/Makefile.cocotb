# Generated by NNC Pipeline: cocotb part of the reproduction kit (called by Makefile).
TOP_DIR := $(abspath ..)
SIM ?= verilator
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(TOP_DIR)/rtl/VLSIT_CELL_SRAM_1W1R.sv $(TOP_DIR)/rtl/m_vlsit_sfifo_ram_macro.sv $(TOP_DIR)/rtl/m_vlsit_sfifo_mem.sv $(TOP_DIR)/rtl/m_vlsit_sfifo_rd.sv $(TOP_DIR)/rtl/m_vlsit_sfifo_wr.sv $(TOP_DIR)/rtl/m_vlsit_sfifo_top.sv $(TOP_DIR)/verif/sva/nnc_chk_clk.sv $(TOP_DIR)/verif/sva/nnc_chk_inputs.sv $(TOP_DIR)/verif/sva/nnc_chk_rd.sv $(TOP_DIR)/verif/sva/nnc_chk_sb.sv $(TOP_DIR)/verif/sva/nnc_chk_srst.sv $(TOP_DIR)/verif/sva/nnc_chk_wr.sv $(TOP_DIR)/verif/sva/nnc_cov.sv $(CURDIR)/nnc_tb_top.sv
COCOTB_TOPLEVEL = nnc_tb_top
COCOTB_TEST_MODULES ?= test_sync_fifo
EXTRA_ARGS += --assert --timing -Wno-fatal -Wno-WIDTH -Wno-UNOPTFLAT -GPARA_SFIFO_DEPTH=8 -GPARA_SFIFO_DATA_W=32 -GPARA_SFIFO_PTR_RETIME=0 -GPARA_SFIFO_MEM_USE_MACRO=0 --coverage-line --coverage-toggle --coverage-expr
SEED ?= 1
export NNC_SEED = $(SEED)
export COCOTB_RANDOM_SEED = $(SEED)
export PYTHONPATH := $(CURDIR):$(TOP_DIR)/verif/tests:$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim
