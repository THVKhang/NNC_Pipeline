# Generated by NNC Pipeline: cocotb part of configuration xrand (called by Makefile).
TOP_DIR := $(abspath ../../..)
KIT_DIR := $(abspath ../..)
SIM ?= verilator
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(TOP_DIR)/rtl/VLSIT_CELL_SRAM_1W1R.sv $(TOP_DIR)/rtl/m_vlsit_sfifo_ram_macro.sv $(TOP_DIR)/rtl/m_vlsit_sfifo_mem.sv $(TOP_DIR)/rtl/m_vlsit_sfifo_rd.sv $(TOP_DIR)/rtl/m_vlsit_sfifo_wr.sv $(TOP_DIR)/rtl/m_vlsit_sfifo_top.sv $(TOP_DIR)/verif/sva/nnc_chk_clk.sv $(TOP_DIR)/verif/sva/nnc_chk_inputs.sv $(TOP_DIR)/verif/sva/nnc_chk_rd.sv $(TOP_DIR)/verif/sva/nnc_chk_sb.sv $(TOP_DIR)/verif/sva/nnc_chk_srst.sv $(TOP_DIR)/verif/sva/nnc_chk_wr.sv $(TOP_DIR)/verif/sva/nnc_cov.sv $(KIT_DIR)/nnc_tb_top.sv
COCOTB_TOPLEVEL = nnc_tb_top
COCOTB_TEST_MODULES ?= test_sync_fifo
EXTRA_ARGS += --assert --timing -Wno-fatal -Wno-WIDTH -Wno-UNOPTFLAT +incdir+$(TOP_DIR)/rtl -GPARA_SFIFO_DEPTH=8 -GPARA_SFIFO_DATA_W=32 -GPARA_SFIFO_PTR_RETIME=0 -GPARA_SFIFO_MEM_USE_MACRO=0 --coverage-line --coverage-toggle --coverage-expr
EXTRA_ARGS += --x-assign unique --x-initial unique +define+NNC_X_INIT
PLUSARGS += +verilator+rand+reset+2 +verilator+seed+$(shell expr $(SEED) + 1) +NNC_X_INIT
SEED ?= 1
export NNC_SEED = $(SEED)
export COCOTB_RANDOM_SEED = $(SEED)
export NNC_INTERFACE := $(CURDIR)/nnc_interface.json
export PYTHONPATH := $(KIT_DIR):$(TOP_DIR)/verif/tests:$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim
