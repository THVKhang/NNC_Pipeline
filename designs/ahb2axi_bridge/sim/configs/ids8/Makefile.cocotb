# Generated by NNC Pipeline: cocotb part of configuration ids8 (called by Makefile).
TOP_DIR := $(abspath ../../..)
KIT_DIR := $(abspath ../..)
SIM ?= verilator
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(TOP_DIR)/rtl/m_ahb2axi_ahb_if.sv $(TOP_DIR)/rtl/m_ahb2axi_axi_if.sv $(TOP_DIR)/rtl/VLSIT_CELL_SRAM_1W1R.sv $(TOP_DIR)/rtl/m_vlsit_sfifo_ram_macro.sv $(TOP_DIR)/rtl/m_vlsit_sfifo_mem.sv $(TOP_DIR)/rtl/m_vlsit_sfifo_rd.sv $(TOP_DIR)/rtl/m_vlsit_sfifo_wr.sv $(TOP_DIR)/rtl/m_vlsit_sfifo_top.sv $(TOP_DIR)/rtl/m_ahb2axi_ctrl.sv $(TOP_DIR)/rtl/m_ahb2axi_top.sv $(TOP_DIR)/verif/sva/nnc_chk_ahb.sv $(TOP_DIR)/verif/sva/nnc_chk_axi.sv $(TOP_DIR)/verif/sva/nnc_chk_cross.sv $(TOP_DIR)/verif/sva/nnc_chk_reset.sv $(TOP_DIR)/verif/sva/nnc_cov.sv $(KIT_DIR)/nnc_tb_top.sv
COCOTB_TOPLEVEL = nnc_tb_top
COCOTB_TEST_MODULES ?= test_ahb2axi_bridge
EXTRA_ARGS += --assert --timing -Wno-fatal -Wno-WIDTH -Wno-UNOPTFLAT +incdir+$(TOP_DIR)/rtl -GPARA_RD_ID_COUNT=8 -GPARA_WR_ID_COUNT=8 --coverage-line --coverage-toggle --coverage-expr
SEED ?= 1
export NNC_SEED = $(SEED)
export COCOTB_RANDOM_SEED = $(SEED)
export NNC_INTERFACE := $(CURDIR)/nnc_interface.json
export PYTHONPATH := $(KIT_DIR):$(TOP_DIR)/verif/tests:$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim
