    ],
    "equivalent": false,
    "reason": "The async reset value of o_apb_pwakeup becomes 1, so it is high during slv reset and, in APB4, stays 1 until the first clock edge after reset release, instead of 0."
   },
   "M03": {
    "rules": [
     "AB2-1.3-01",
     "AB2-1.3-05",
     "AB2-3-01",
     "AB2-10.2-01",
     "AB2-1.3-03"
    ],
    "equivalent": false,
    "reason": "The delay model updates its output only when the stage input is unchanged, so with the model enabled a real toggle of req/ack is no longer picked up as a change and crossings are lost or wrongly delayed, hanging the transfer."
   },
   "M04": {
    "rules": [
