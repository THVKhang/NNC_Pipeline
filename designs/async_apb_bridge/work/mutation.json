    "equivalent": false,
    "reason": "Inverting w_req_event makes the completer FSM leave IDLE when there is no request and ignore a real one, so PSEL rises with no Setup and requested transfers are lost."
   },
   "M02": {
    "rules": [
     "AB2-7.3-02",
