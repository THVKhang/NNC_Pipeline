# Generated by NNC Pipeline: cocotb part of the reproduction kit (called by Makefile).
TOP_DIR := $(abspath ..)
SIM ?= verilator
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = $(TOP_DIR)/rtl/VLSIT_CELL_SYNC_DFF_RN.sv $(TOP_DIR)/rtl/VLSIT_CELL_SYNC_DFF_SN.sv $(TOP_DIR)/rtl/VLSIT_CELL_SYNC_2FF_RN.sv $(TOP_DIR)/rtl/VLSIT_CELL_SYNC_2FF_SN.sv $(TOP_DIR)/rtl/VLSIT_CELL_SYNC_3FF_RN.sv $(TOP_DIR)/rtl/VLSIT_CELL_SYNC_3FF_SN.sv $(TOP_DIR)/rtl/VLSIT_CELL_SYNC_4FF_RN.sv $(TOP_DIR)/rtl/VLSIT_CELL_SYNC_4FF_SN.sv $(TOP_DIR)/rtl/m_vlsit_apbcdc_cell_sync.sv $(TOP_DIR)/rtl/m_vlsit_apbcdc_sync.sv $(TOP_DIR)/rtl/m_vlsit_apbcdc_mst.sv $(TOP_DIR)/rtl/m_vlsit_apbcdc_slv.sv $(TOP_DIR)/rtl/m_vlsit_apbcdc_top.sv $(TOP_DIR)/verif/sva/nnc_chk_apb5off.sv $(TOP_DIR)/verif/sva/nnc_chk_glitch.sv $(TOP_DIR)/verif/sva/nnc_chk_mstif.sv $(TOP_DIR)/verif/sva/nnc_chk_rst.sv $(TOP_DIR)/verif/sva/nnc_chk_slvif.sv $(TOP_DIR)/verif/sva/nnc_chk_wake.sv $(TOP_DIR)/verif/sva/nnc_cov.sv $(CURDIR)/nnc_tb_top.sv
COCOTB_TOPLEVEL = nnc_tb_top
COCOTB_TEST_MODULES ?= test_async_apb_bridge
EXTRA_ARGS += --assert --timing -Wno-fatal -Wno-WIDTH -Wno-UNOPTFLAT -GPARA_APBCDC_ADDR_W=32 -GPARA_APBCDC_DATA_W=32 -GPARA_APBCDC_APB5=0 -GPARA_APBCDC_USER_REQ_W=0 -GPARA_APBCDC_USER_DATA_W=0 -GPARA_APBCDC_USER_RESP_W=0 -GPARA_APBCDC_HS_TYPE=0 -GPARA_APBCDC_CELL_TYPE=2 --coverage-line --coverage-toggle --coverage-expr
PLUSARGS += +APBCDC_MSYNC_SEED=$(SEED) +APBCDC_MSYNC_EN=1
SEED ?= 1
export NNC_SEED = $(SEED)
export COCOTB_RANDOM_SEED = $(SEED)
export PYTHONPATH := $(CURDIR):$(TOP_DIR)/verif/tests:$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim
