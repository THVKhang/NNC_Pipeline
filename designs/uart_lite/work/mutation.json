    "rules": [
     "UL-5-12",
     "UL-6.2-02",
     "UL-6.2-08",
     "UL-7.8-04"
    ],
    "equivalent": false,
    "reason": "o_rx_overrun would reset to 1 instead of 0. The output has the wrong value during reset."
   },
   "M22": {
    "rules": [
     "UL-7.5-02",
     "UL-7.5-01",
     "UL-1.1-01",
     "UL-8.2-01"
    ],
    "equivalent": false,
    "reason": "The bit-count test is negated, so the receiver goes to the stop state after the first data bit and then keeps counting. Sampling points and delivery are wrong."
   },
   "M23": {
    "rules": [
     "UL-5-14",
     "UL-6.2-02",
     "UL-6.2-06",
     "UL-14-08",
     "UL-6.2-01"
    ],
    "equivalent": false,
    "reason": "o_txd would reset to 0 instead of 1. The line is low during reset and an abandoned frame does not return the line high."
   },
   "M24": {
    "rules": [
     "UL-6.2-05",
     "UL-14-06",
     "UL-6.2-12",
     "UL-10.5-01"
    ],
    "equivalent": false,
    "reason": "The second synchronizer flop would reset to 0. After reset a start fall (prev=1, sync=0) is detected spuriously."
   },
   "M25": {
    "rules": [
     "UL-7.2-01",
     "UL-5-02",
     "UL-7.2-02",
     "UL-7.2-06",
     "UL-6.2-03"
    ],
    "equivalent": false,
    "reason": "The accept condition is negated, so a byte is accepted when i_tx_valid=0 or o_tx_ready=0 and not accepted at the handshake. Nothing is transmitted correctly."
   },
   "M26": {
    "rules": [
     "UL-7.8-04",
     "UL-7.4-06",
     "UL-10.4-03",
     "UL-7.6-01",
     "UL-7.5-05"
    ],
    "equivalent": false,
    "reason": "The default for w_rx_frame_done would be 1, so frames are signalled complete in every state. This gives spurious loads and overrun pulses."
   },
   "M27": {
    "rules": [
     "UL-7.5-01",
     "UL-14-02",
     "UL-1.1-02",
     "UL-7.5-03"
    ],
    "equivalent": false,
    "reason": "The nonzero test in the data state is inverted. The counter decrements only at zero and the data bit is sampled at the wrong edges. The byte is wrong."
   },
   "M28": {
    "rules": [
     "UL-5-03",
     "UL-6.2-02",
     "UL-14-01",
     "UL-6.2-10",
     "UL-6.2-01"
    ],
    "equivalent": false,
    "reason": "o_tx_ready would reset to 0 instead of 1. The transmitter is not ready in and after reset."
   },
   "M29": {
    "rules": [
     "UL-7.6-01",
     "UL-8.2-01",
     "UL-14-03",
     "UL-1.2-05",
     "UL-5-06"
    ],
    "equivalent": false,
    "reason": "On load o_rx_valid would be set to 0 rather than 1. A received byte is never presented as valid."
   },
   "M30": {
    "rules": [
     "UL-6.2-01",
     "UL-6.2-02",
     "UL-6.2-06",
     "UL-14-08",
     "UL-6.2-10"
    ],
    "equivalent": false,
    "reason": "The TX reset test is inverted. Reset does not abandon a frame or set o_txd/o_tx_ready, and the normal logic is held in reset when reset is released."
   },
   "M31": {
    "rules": [
